{
  "permissions": {
    "allow": [
      "Shell(dir:*)",
      "Shell(node -v)",
      "Shell(npm:*)",
      "Shell(npx create-expo-app@latest mobile --template default --yes)",
      "Shell(dir /a node_modules 2>nul | find /c /v \"\" & dir package-lock.json 2>nul)",
      "Shell(npx tsc --noEmit)",
      "Shell(npx expo start --port 8081)",
      "Shell(dir /b node_modules\\@expo\\vector-icons node_modules\\expo-font 2>nul)",
      "Shell(npx expo install @expo/vector-icons @expo-google-fonts/space-grotesk)",
      "Shell(if:*)",
      "Shell(else:*)",
      "Shell(node -e console.log(require('./package.json').dependencies))",
      "Shell(del:*)",
      "Shell(mkdir:*)",
      "Shell(curl -s -o \"%TEMP%\\mobile-bundle.js\" -w \"%{http_code} %{size_download}\" \"http://localhost:8081/node_modules/expo-router/entry.bundle?platform=android&dev=true&minify=false\")",
      "Shell(findstr:*)",
      "Shell(more:*)",
      "Shell(agent-browser:*)",
      "Shell(npx expo export --platform android --output-dir .expo-check)",
      "Shell(findstr /c:\"Discover products picked for you\" /c:\"Favourites\" /c:\"SpaceGrotesk_700Bold\" /c:\"home-outline\" .expo-check\\_expo\\static\\js\\android\\*.hbc 2>nul | find /c /v \"\")",
      "Shell(rmdir:*)",
      "Shell(node -e \"const p=require('./node_modules/@expo-google-fonts/space-grotesk/package.json'); console.log(p.version); console.log(Object.keys(require('./node_modules/@expo-google-fonts/space-grotesk')).join('\\n'))\")",
      "powershell",
      "Shell(curl -s -o %TEMP%\\m2.js -w %{http_code} %{size_download}\\n http://localhost:8081/node_modules/expo-router/entry.bundle?platform=android&dev=true&minify=false)",
      "Shell(curl -s http://localhost:8081/ -H Accept: application/json -o %TEMP%\\manifest.json -w %{http_code}\\n)",
      "Shell(dir /s /b node_modules\\@expo\\vector-icons\\build\\vendor\\react-native-vector-icons\\Fonts 2>nul)",
      "Shell(node -p require('./node_modules/@expo/vector-icons/package.json').version)",
      "Shell(curl -s -o %TEMP%\\ions.js -w android %{http_code} %{size_download}\\n http://localhost:8081/node_modules/@expo/vector-icons/build/Ionicons.bundle?platform=android&dev=true)",
      "Shell(curl -s -o \"%TEMP%\\ionsw.js\" -w \"web %{http_code} %{size_download}\\n\" \"http://localhost:8081/node_modules/@expo/vector-icons/build/Ionicons.bundle?platform=web&dev=true\")",
      "Shell(npx expo start --port 8090 --clear)",
      "Shell(curl -s -o \"%TEMP%\\ions2.js\" -w \"%{http_code} %{size_download}\\n\" \"http://localhost:8090/node_modules/@expo/vector-icons/build/Ionicons.bundle?platform=android&dev=true\")",
      "Shell(curl -s -o %TEMP%\\m3.js -w %{http_code} %{size_download}\\n http://localhost:8090/node_modules/expo-router/entry.bundle?platform=android&dev=true&minify=false)",
      "Shell(curl -s -o NUL -w \"%{http_code}\\n\" \"http://localhost:8081/node_modules/@expo/vector-icons/build/Ionicons.bundle?platform=android&dev=true\")",
      "Shell(set:*)",
      "Shell(npx expo start --port 8081 --clear)",
      "Shell(git:*)",
      "Shell(type:*)"
    ],
    "deny": [],
    "defaultMode": "default"
  }
}